# Normalise everything in the repository to LF, then restore the working
# tree per type on checkout.
* text=auto eol=lf

# AutoHotkey is a Windows-only runtime and Inno Setup scripts are read by
# a Windows compiler: both get CRLF in the working tree, on every platform.
*.ahk   text eol=crlf
*.iss   text eol=crlf
*.ps1   text eol=crlf

# Fetched binaries, never diffed.
*.exe   binary
*.dll   binary
*.bin   binary
*.zip   binary
