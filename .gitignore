# Fetched at install time, never committed: see versions.json for the
# pinned version and SHA-256 of each one.
/bin/
/models/
/AutoHotkey64.exe

# Generated on every build from versions.json, and the .iss refuses
# to compile without it - so there is nothing to keep in sync here.
/installer/pins.iss

# Build output of the installer.
/dist/

# Test output.
/tests/results.txt
/tests/err.txt

# Scratch space used by the validation scripts.
/.work/
/.probe*
